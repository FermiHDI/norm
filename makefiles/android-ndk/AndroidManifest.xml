<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
      package="mil.navy.nrl.norm"
      android:versionCode="1"
      android:versionName="1.0">
    <uses-sdk android:minSdkVersion="14"
              android:targetSdkVersion="23"/>
    <!-- A library: no user data to back up, and NORM speaks UDP, so nothing
         here needs cleartext HTTP. Declaring both keeps an app that merges this
         manifest from inheriting the permissive defaults. -->
    <application android:allowBackup="false"
                 android:fullBackupContent="false"
                 android:usesCleartextTraffic="false" />
</manifest>
